<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Bee Mead -->  
  
  	<ThingDef ParentName="DrugBase">
		<defName>ISA_BeeMead</defName>
		<label>honey mead</label>
		<description>One of the first fermented beverages, mead is made with sweet honey. It is more alcoholic than beer but is generally considered to taste better.</description>
		<graphicData>
			<texPath>Things/Bee/Mead</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<equippedAngleOffset>-150</equippedAngleOffset>
		<rotatable>false</rotatable>
		<stackLimit>25</stackLimit>
		<statBases>
			<DeteriorationRate>0.5</DeteriorationRate>
			<MarketValue>16</MarketValue>
			<Mass>0.3</Mass>
			<Flammability>0.5</Flammability>
			<Nutrition>0.08</Nutrition>
		</statBases>
		<ingestible>
			<foodType>Fluid, Processed, Liquor</foodType>
			<joyKind>Chemical</joyKind>
			<joy>0.30</joy>
			<nurseable>true</nurseable>
			<drugCategory>Social</drugCategory>
			<ingestSound>Ingest_Beer</ingestSound>
			<ingestHoldOffsetStanding>
				<northDefault>
					<offset>(0.18,0,0)</offset>
				</northDefault>
			</ingestHoldOffsetStanding>
			<ingestCommandString>Drink {0}</ingestCommandString>
			<ingestReportString>Drinking {0}.</ingestReportString>
			<chairSearchRadius>25</chairSearchRadius>
			<outcomeDoers>
				<li Class="IngestionOutcomeDoer_GiveHediff">
					<hediffDef>AlcoholHigh</hediffDef>
					<severity>0.22</severity>
					<toleranceChemical>Alcohol</toleranceChemical>
				</li>
				<li Class="IngestionOutcomeDoer_GiveHediff">
					<hediffDef>AlcoholTolerance</hediffDef>
					<severity>0.015</severity>
					<divideByBodySize>true</divideByBodySize>
				</li>
			</outcomeDoers>
		</ingestible>
		<comps>
			<li Class="CompProperties_Drug">
				<chemical>Alcohol</chemical>
				<addictiveness>0.010</addictiveness>
				<minToleranceToAddict>0.25</minToleranceToAddict>
				<existingAddictionSeverityOffset>0.20</existingAddictionSeverityOffset>
				<needLevelOffset>0.9</needLevelOffset>
				<listOrder>10</listOrder>
			</li>
			<li>
				<compClass>CompEquippable</compClass>
			</li>
		</comps>
		<techLevel>Neolithic</techLevel>
		<researchPrerequisites>
			<li>Brewing</li>
		</researchPrerequisites>
    <equipmentType>Primary</equipmentType>
    <weaponClasses>
      <li>Melee</li>
      <li>MeleeBlunt</li>
    </weaponClasses>
    <tools>
      <li>
        <label>bottle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>neck</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
	</ThingDef>

<!-- Hornet Mead -->
	
	<ThingDef ParentName="DrugBase">
		<defName>ISA_HornetMead</defName>
		<label>hornet mead</label>
		<description>Fermented hornet honey, a very strong and intoxicating alcohol. The potency is such that one drink can almost lead to a direct black out. Originating from the northern lands, it was brewed to keep oneself warm during the harsh winters.</description>
		<graphicData>
			<texPath>Things/Hornet/HornetMead</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<equippedAngleOffset>-150</equippedAngleOffset>
		<rotatable>false</rotatable>
		<stackLimit>25</stackLimit>
		
		<statBases>
			<DeteriorationRate>0.5</DeteriorationRate>
			<MarketValue>70</MarketValue>
			<Mass>0.3</Mass>
			<Flammability>0.5</Flammability>
			<Nutrition>0.08</Nutrition>
		</statBases>
		
		<ingestible>
			<foodType>Fluid, Processed, Liquor</foodType>
			<joyKind>Chemical</joyKind>
			<joy>0.60</joy>
			<nurseable>true</nurseable>
			<drugCategory>Social</drugCategory>
			<ingestSound>Ingest_Beer</ingestSound>
			<ingestHoldOffsetStanding>
				<northDefault>
					<offset>(0.18,0,0)</offset>
				</northDefault>
			</ingestHoldOffsetStanding>
			<ingestCommandString>Drink {0}</ingestCommandString>
			<ingestReportString>Drinking {0}.</ingestReportString>
			<chairSearchRadius>25</chairSearchRadius>
			<outcomeDoers>
				<li Class="IngestionOutcomeDoer_GiveHediff">
					<hediffDef>AlcoholHigh</hediffDef>
					<severity>0.8</severity>
					<toleranceChemical>Alcohol</toleranceChemical>
				</li>
				<li Class="IngestionOutcomeDoer_GiveHediff">
					<hediffDef>AlcoholTolerance</hediffDef>
					<severity>0.15</severity>
					<divideByBodySize>true</divideByBodySize>
				</li>
				<li Class="IngestionOutcomeDoer_GiveHediff">
					<hediffDef>ISA_HornetHoneyHigh</hediffDef>
					<severity>0.2</severity>
					<divideByBodySize>true</divideByBodySize>
				</li>
			<li Class="IngestionOutcomeDoer_OffsetNeed">
					<need>Rest</need>
					<offset>0.4</offset>
					<toleranceChemical>ISA_HornetHoney</toleranceChemical>
				</li>
			</outcomeDoers>
		</ingestible>
		
		<comps>
			<li Class="CompProperties_Drug">
				<chemical>Alcohol</chemical>
				<addictiveness>0.010</addictiveness>
				<minToleranceToAddict>0.25</minToleranceToAddict>
				<existingAddictionSeverityOffset>0.20</existingAddictionSeverityOffset>
				<needLevelOffset>0.9</needLevelOffset>
				<listOrder>10</listOrder>
			</li>
			<li>
				<compClass>CompEquippable</compClass>
			</li>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li Class="VEF.Cooking.CompProperties_IngestedThoughtFromQuality">
				<ingestedThought>ISA_DrankWine</ingestedThought>
			</li>
			<li Class="VEF.Cooking.CompProperties_StackByQuality"/>
		</comps>
		<techLevel>Neolithic</techLevel>
		<researchPrerequisites>
			<li>Brewing</li>
		</researchPrerequisites>
	</ThingDef>

<!-- Pollen -->
  
  <ThingDef ParentName="DrugBase">
    <defName>ISA_Pollen</defName>
    <label>pollen</label>
    <description>A collection of powdery pollen gathered from domestic apiaries. It gives a minor high when snorted.</description>
    <descriptionHyperlinks>
      <HediffDef>ISA_PollenBuzz</HediffDef>
      <HediffDef>ISA_PollenTolerance</HediffDef>
      <HediffDef>ISA_PollenAddiction</HediffDef>
    </descriptionHyperlinks>
    <tradeability>Sellable</tradeability>
    <socialPropernessMatters>true</socialPropernessMatters>
    <tickerType>Rare</tickerType>
    <graphicData>
			<texPath>Things/MiscItems/PollenBag</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>5</MarketValue>
      <Mass>0.1</Mass>
      <DeteriorationRate>4</DeteriorationRate>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <techLevel>Neolithic</techLevel>
    <ingestible>
      <baseIngestTicks>80</baseIngestTicks>
      <chairSearchRadius>4</chairSearchRadius>
      <preferability>DesperateOnly</preferability>
      <tasteThought></tasteThought>
      <foodType>VegetableOrFruit</foodType>
      <joyKind>Chemical</joyKind>
      <joy>0.1</joy>
      <ingestSound>Ingest_Snort</ingestSound>
      <ingestHoldUsesTable>false</ingestHoldUsesTable>
      <ingestCommandString>Snort {0}</ingestCommandString>
      <ingestReportString>Snorting {0}.</ingestReportString>
      <useEatingSpeedStat>true</useEatingSpeedStat>
      <nurseable>true</nurseable>
      <drugCategory>Medical</drugCategory>
      <canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>ISA_PollenBuzz</hediffDef>
          <severity>0.50</severity>
          <toleranceChemical>ISA_Pollen</toleranceChemical>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>ISA_PollenTolerance</hediffDef>
          <toleranceChemical>ISA_Pollen</toleranceChemical>
          <severity>0.01</severity>
          <divideByBodySize>true</divideByBodySize>
          <multiplyByGeneToleranceFactors>true</multiplyByGeneToleranceFactors>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>30</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_Drug">
        <chemical>ISA_Pollen</chemical>
        <addictiveness>0.005</addictiveness>
        <minToleranceToAddict>0.25</minToleranceToAddict>
        <existingAddictionSeverityOffset>0.1</existingAddictionSeverityOffset>
        <needLevelOffset>0.9</needLevelOffset>
        <listOrder>30</listOrder>
      </li>
    </comps>
    <allowedArchonexusCount>50</allowedArchonexusCount>
  </ThingDef>

</Defs>
