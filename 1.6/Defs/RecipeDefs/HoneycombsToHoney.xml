<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Bee Honeycomb -->
  
	<RecipeDef>
		<defName>ISA_BeeHoneycombProcessing</defName>
		<label>make honey and wax from (bees) honeycomb</label>
		<description>Make delicious honey and useful wax from (bees) honeycomb.</description>
		<jobString>Processing honeycomb.</jobString>
		<workSpeedStat>CookSpeed</workSpeedStat>
		<workSkill>Cooking</workSkill>
		<effectWorking>Cook</effectWorking>
		<workAmount>600</workAmount>
		<soundWorking>Recipe_Brewing</soundWorking>
		<allowMixingIngredients>true</allowMixingIngredients>
		<recipeUsers>
			<li>Campfire</li>
			<li>ElectricStove</li>
			<li>FueledStove</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ISA_BeeHoneycomb</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>ISA_BeeHoneycomb</li>
			</thingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<thingDefs>
				<li>ISA_BeeHoneycomb</li>
			</thingDefs>
		</defaultIngredientFilter>
		<products>
			<ISA_Waxblock>12</ISA_Waxblock>
			<ISA_BeeHoney>8</ISA_BeeHoney>
		</products>
    	<researchPrerequisites>
    	  <li>ISA_Beekeeping</li>
    	</researchPrerequisites>
	</RecipeDef>

